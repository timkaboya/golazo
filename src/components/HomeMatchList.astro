---
import type { FootballMatch } from '../lib/football-types';

interface DisplayMatch extends FootballMatch {
  competition?: string;
}

interface Props {
  title: string;
  matches: DisplayMatch[];
  empty: string;
}

const { title, matches, empty } = Astro.props;
const score = (match: DisplayMatch, side: 'home' | 'away') =>
  match.score ? match.score[side] : '';
---

<section class="home-match-group">
  <h3>{title}</h3>
  {matches.length ? (
    <div class="home-match-list">
      {matches.slice(0, 4).map((match) => (
        <article>
          <div class="home-match-meta">
            <span>{match.competition || match.phase}</span>
            <time datetime={match.utc} data-local>{new Date(match.utc).toUTCString()}</time>
          </div>
          <div class="home-match-team">
            {match.home.logo ? <img src={match.home.logo} alt="" loading="lazy" /> : <span />}
            <strong>{match.home.name}</strong>
            <b>{score(match, 'home')}</b>
          </div>
          <div class="home-match-team">
            {match.away.logo ? <img src={match.away.logo} alt="" loading="lazy" /> : <span />}
            <strong>{match.away.name}</strong>
            <b>{score(match, 'away')}</b>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="home-match-empty">{empty}</p>
  )}
</section>
