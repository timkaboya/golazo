{
  "name": "golazo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Golazo — a static-first hub for major football competitions.",
  "scripts": {
    "dev": "astro dev",
    "data": "node --experimental-strip-types scripts/fetch-espn.ts",
    "data:news": "node --experimental-strip-types scripts/fetch-news.ts",
    "data:football": "node --experimental-strip-types scripts/fetch-football.ts",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler pages dev dist",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "perf": "node scripts/check-bundle.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "^4.0.1",
    "astro": "^4.16.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
